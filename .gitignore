# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/test-results
/playwright-report
/.lighthouse

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# env / secrets
.env*
!.env.example
# Public build settings for the deploy (no secrets in it).
!.env.production
.dev.vars
!.dev.vars.example

# cloudflare
.wrangler/

# raw asset downloads (re-fetch with `pnpm assets:fetch`)
/assets-src/

# blender working files (only blessed finals are committed)
/blender/scenes/*.blend
/blender/scenes/*.blend1
!/blender/scenes/*_final.blend
/blender/bakes/
__pycache__/

# misc
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
.pnpm-debug.log*

# mood references are third-party images: local only, never published
/reference/*
!/reference/README.md
blender/content.json
screenshots/blender/*_test.png
/public/basis/

# Screenshot scratch (iterations, profiling, white-balance trials); checkpoint shots stay tracked
screenshots/phase-*/baseline/
screenshots/phase-*/iter/
screenshots/phase-*/prod/
screenshots/phase-*/prof/
screenshots/phase-*/wb/
# Browser-vs-Cycles matching: only the side-by-side comparisons are kept
screenshots/phase-*/match/*
!screenshots/phase-*/match/compare-*.png
# Lite-file design and review captures
screenshots/design/
screenshots/phase-*/lite/

# Work-in-progress captures stay local; only the final Cycles stills are kept
screenshots/*
!screenshots/blender/
