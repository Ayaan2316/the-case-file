{
  "name": "case-file",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p functions && tsc --noEmit -p workers/tip-mailer",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "budgets": "node scripts/check-budgets.mjs",
    "blender": "pnpm content:export && node scripts/blender.mjs",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "demo-photos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-photos.mjs",
    "resume:pdf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/resume-pdf.mjs",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "audio:fetch": "node scripts/fetch-audio.mjs",
    "content:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-content.mjs",
    "assets:optimize": "node scripts/optimize.mjs",
    "decoders": "node scripts/copy-decoders.mjs",
    "predev": "pnpm decoders",
    "prebuild": "pnpm decoders",
    "shots": "node scripts/shots.mjs",
    "brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/brand-images.mjs",
    "photos": "node scripts/photos.mjs",
    "lite:images": "node scripts/lite-images.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lenis": "^1.3.27",
    "maath": "^0.10.8",
    "next": "16.4.6",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "leva": "^0.10.1",
    "lighthouse": "^13.6.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "wrangler": "^4.156.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  }
}
